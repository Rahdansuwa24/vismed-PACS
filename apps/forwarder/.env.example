# ==========================================================
# KONFIGURASI FORWARDER ECG (EDAN)
# ==========================================================

# Direktori yang dipantau (Folder tempat file PDF diekspor oleh FTP / Alat EKG)
WATCH_DIR=/home/pacs/servers/data/ftp_incoming

# Orthanc PACS Central Konfigurasi
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# Backend Monitoring VISMED
BACKEND_URL=http://127.0.0.1:3000

# Konfigurasi Identitas Alat & Nama Ruangan
STATION_NAME=RUANG_EKG_1
DICOM_AET=VISMED_FORWARDER
DICOM_INSTITUTION_NAME=RSI_SURABAYA


# ==========================================================
# ENDPOINT API SIMRS MITRA (Sesuaikan bila endpoint tersedia)
# ==========================================================

# 1. Cek Data Pelayanan (POST: { id_pelayanan: ... })
SIMRS_CHECK_PELAYANAN_URL=https://api.rsisurabaya.com:8008/registration/get-pelayanan-by-id

# 2. Get Token Otentikasi (POST: { norm: ..., birthdate: ... })
SIMRS_GET_TOKEN_URL=https://api.rsisurabaya.com:8008/auth

# 3. Upload Berkas Gambar ECG Form-Data (POST: multipart/form-data + Header Bearer Token)
SIMRS_UPLOAD_ECG_URL=https://api.rsisurabaya.com:8008/hasil-penunjang/upload-hasil-ecg
