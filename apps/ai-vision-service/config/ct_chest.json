{
  "domain": "ct_chest",
  "task": "classification",
  "modelPath": "models/ct_chest/model.onnx",
  "input": {
    "width": 224,
    "height": 224,
    "channels": 3,
    "layout": "NCHW",
    "preprocessing": "standard",
    "scale": 255.0,
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "output": {
    "activation": "softmax",
    "threshold": 0.3,
    "labels": [
      "Adenocarcinoma",
      "Large Cell Carcinoma",
      "Normal",
      "Squamous Cell Carcinoma"
    ]
  },
  "inputName": "input",
  "source": {
    "library": "dorsar/lung-cancer-detection",
    "dataset": "Lung Cancer CT (HuggingFace dorsar/lung-cancer)",
    "note": "Classifies lung cancer types from axial Chest CT slices. Pretrained model from HuggingFace."
  }
}
