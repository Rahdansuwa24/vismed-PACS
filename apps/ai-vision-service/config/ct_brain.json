{
  "domain": "ct_brain",
  "task": "classification",
  "modelPath": "models/ct_brain/model.onnx",
  "input": {
    "width": 224,
    "height": 224,
    "channels": 3,
    "layout": "NCHW",
    "preprocessing": "standard",
    "scale": 255.0,
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "output": {
    "activation": "softmax",
    "threshold": 0.3,
    "labels": [
      "Any Hemorrhage",
      "Epidural",
      "Intraparenchymal",
      "Intraventricular",
      "Subarachnoid",
      "Subdural"
    ]
  },
  "inputName": "input",
  "source": {
    "library": "DifeiT/rsna-intracranial-hemorrhage-detection",
    "dataset": "RSNA 2019 Intracranial Hemorrhage Detection",
    "note": "ViT-Base-Patch16-224 fine-tuned on RSNA 2019. Classifies intracranial hemorrhage subtypes in axial Brain CT slices. Converted from HuggingFace safetensors to ONNX."
  }
}
